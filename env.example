# Local uniquement : copier dans .env et remplacer les valeurs.
# Neon > Connect > connexion PostgreSQL (pooling activé)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-long
SESSION_SECRET=remplacer-par-une-cle-aleatoire-de-64-caracteres
CRON_SECRET=remplacer-par-une-autre-cle-aleatoire-de-64-caracteres
APP_URL=http://localhost:3000
PORT=3000
INVITE_CODE=remplacer-par-un-code-partage-avec-les-amis
# Les clés push et les avatars sont stockés dans PostgreSQL, pas sur Render.
# VAPID_SUBJECT=mailto:votre-adresse@example.com

# Envoi des codes de récupération par e-mail (facultatif pour démarrer).
RESEND_API_KEY=
EMAIL_FROM=
# Exemple EMAIL_FROM : Pari à Long Terme <connexion@votre-domaine.fr>
